---
import BaseLayout from '../layouts/BaseLayout.astro';
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';

const title = "404 - Page Not Found | Medical Malpractice Lawyer Near Me";
const description = "The page you are looking for does not exist or has been removed from our directory.";
---

<BaseLayout title={title} description={description} canonicalPath="/404.html">
  <Header />
  <main class="not-found-main">
    <div class="container not-found-container">
      <span class="error-code">404</span>
      <h1>Page Not Found</h1>
      <p class="error-message">
        The page or listing you are looking for does not exist, has been removed, or the link is incorrect.
      </p>
      <div class="actions">
        <a href="/" class="btn btn-primary">Go to Homepage</a>
        <a href="/find-lawyer" class="btn btn-secondary">Find a Lawyer</a>
      </div>
    </div>
  </main>
  <Footer />
</BaseLayout>

<style>
  .not-found-main {
    padding: 100px 0;
    min-height: 60vh;
    display: flex;
    align-items: center;
    justify-content: center;
    text-align: center;
  }

  .not-found-container {
    max-width: 600px;
    margin: 0 auto;
    padding: 0 20px;
  }

  .error-code {
    display: block;
    font-size: 6rem;
    font-weight: 800;
    color: var(--color-primary, #1e3a8a);
    line-height: 1;
    margin-bottom: 16px;
  }

  h1 {
    font-size: 2.25rem;
    font-weight: 700;
    margin-bottom: 16px;
    color: var(--color-text, #1f2937);
  }

  .error-message {
    font-size: 1.125rem;
    color: var(--color-text-muted, #6b7280);
    margin-bottom: 32px;
    line-height: 1.6;
  }

  .actions {
    display: flex;
    gap: 16px;
    justify-content: center;
    flex-wrap: wrap;
  }

  .btn {
    display: inline-block;
    padding: 12px 28px;
    border-radius: 8px;
    font-weight: 600;
    text-decoration: none;
    transition: all 0.2s ease;
  }

  .btn-primary {
    background-color: var(--color-primary, #1e3a8a);
    color: #ffffff;
  }

  .btn-primary:hover {
    background-color: var(--color-primary-dark, #172554);
  }

  .btn-secondary {
    background-color: var(--color-bg-secondary, #f3f4f6);
    color: var(--color-text, #1f2937);
    border: 1px solid var(--color-border, #e5e7eb);
  }

  .btn-secondary:hover {
    background-color: var(--color-bg-tertiary, #e5e7eb);
  }
</style>
