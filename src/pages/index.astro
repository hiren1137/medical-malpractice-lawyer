---
import BaseLayout from '../layouts/BaseLayout.astro';
import Header from '../components/Header.astro';
import Hero from '../components/Hero.astro';
import TopCities from '../components/TopCities.astro';
import StatesList from '../components/StatesList.astro';
import WhyChooseUs from '../components/WhyChooseUs.astro';
import Footer from '../components/Footer.astro';

const title = "Medical Malpractice Lawyer Near Me - Find Best Attorneys in USA";
const description = "Find the best medical malpractice lawyers near you in the USA. Expert attorneys with verified credentials and client reviews.";
---

<BaseLayout title={title} description={description} canonicalPath="/">
  <Header />
  <main>
    <Hero />
    <TopCities />
    <StatesList />
    <WhyChooseUs />
  </main>
  <Footer />
</BaseLayout>
