---
// Top Cities Component - Major US Cities with correct state-based URLs
const cities = [
  { name: "New York City", state: "New York", stateSlug: "new-york", citySlug: "new-york-city" },
  { name: "Los Angeles", state: "California", stateSlug: "california", citySlug: "los-angeles" },
  { name: "Chicago", state: "Illinois", stateSlug: "illinois", citySlug: "chicago" },
  { name: "Houston", state: "Texas", stateSlug: "texas", citySlug: "houston" },
  { name: "Phoenix", state: "Arizona", stateSlug: "arizona", citySlug: "phoenix" },
  { name: "Philadelphia", state: "Pennsylvania", stateSlug: "pennsylvania", citySlug: "philadelphia" },
  { name: "San Antonio", state: "Texas", stateSlug: "texas", citySlug: "san-antonio" },
  { name: "San Diego", state: "California", stateSlug: "california", citySlug: "san-diego" },
  { name: "Dallas", state: "Texas", stateSlug: "texas", citySlug: "dallas" },
  { name: "Austin", state: "Texas", stateSlug: "texas", citySlug: "austin" },
];
---

<section class="top-cities section">
  <div class="container">
    <div class="section-title">
      <h2>Top Cities</h2>
      <p>Find medical malpractice lawyers in major cities across the United States</p>
    </div>
    
    <div class="cities-grid">
      {cities.map((city, index) => (
        <a 
          href={`/${city.stateSlug}/${city.citySlug}/`} 
          class="city-card"
          style={`animation-delay: ${index * 0.05}s`}
        >
          <div class="city-icon">📍</div>
          <div class="city-info">
            <span class="city-name">{city.name}</span>
            <span class="city-state">{city.state}</span>
          </div>
          <span class="city-arrow">→</span>
        </a>
      ))}
    </div>
  </div>
</section>

<style>
  .top-cities {
    background-color: var(--color-white);
  }
  
  .cities-grid {
    display: grid;
    grid-template-columns: repeat(5, 1fr);
    gap: var(--spacing-4);
  }
  
  .city-card {
    display: flex;
    align-items: center;
    gap: var(--spacing-3);
    padding: var(--spacing-4) var(--spacing-5);
    background-color: var(--color-white);
    border: 2px solid var(--color-gray-200);
    border-radius: var(--radius-lg);
    text-decoration: none;
    transition: all var(--transition-normal);
    animation: fadeIn 0.6s ease forwards;
    opacity: 0;
  }
  
  .city-card:hover {
    border-color: var(--color-black);
    box-shadow: var(--shadow-lg);
    transform: translateY(-2px);
    opacity: 1;
  }
  
  .city-icon {
    font-size: var(--font-size-xl);
    flex-shrink: 0;
  }
  
  .city-info {
    display: flex;
    flex-direction: column;
    flex-grow: 1;
    min-width: 0;
  }
  
  .city-name {
    font-weight: 600;
    color: var(--color-black);
    font-size: var(--font-size-base);
    white-space: nowrap;
    overflow: hidden;
    text-overflow: ellipsis;
  }
  
  .city-state {
    font-size: var(--font-size-sm);
    color: var(--color-gray-500);
  }
  
  .city-arrow {
    font-size: var(--font-size-lg);
    color: var(--color-gray-400);
    transition: all var(--transition-fast);
    flex-shrink: 0;
  }
  
  .city-card:hover .city-arrow {
    color: var(--color-black);
    transform: translateX(4px);
  }
  
  @media (max-width: 1024px) {
    .cities-grid {
      grid-template-columns: repeat(3, 1fr);
    }
  }
  
  @media (max-width: 768px) {
    .cities-grid {
      grid-template-columns: repeat(2, 1fr);
    }
  }
  
  @media (max-width: 480px) {
    .cities-grid {
      grid-template-columns: 1fr;
    }
    
    .city-card {
      padding: var(--spacing-4);
    }
  }
  
  @keyframes fadeIn {
    from {
      opacity: 0;
      transform: translateY(10px);
    }
    to {
      opacity: 1;
      transform: translateY(0);
    }
  }
</style>
